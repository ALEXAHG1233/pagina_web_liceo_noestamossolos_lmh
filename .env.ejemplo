# Copia de ejemplo de .env (SIN claves). El archivo real se llama .env y no se sube a GitHub.
# En Render, estas mismas variables se ponen en: Environment → Environment Variables.

# --- Servicios de IA, en el orden en que se prueban -------------------------
# Si uno se queda sin saldo, sin cuota o falla, el chat pasa solo al siguiente.
ANTHROPIC_API_KEY=
# Si la clave de Claude no es de un "workspace", pon aquí el ID del workspace
# (console.anthropic.com → Settings → Workspaces), o crea la clave dentro de un workspace.
ANTHROPIC_WORKSPACE_ID=
GROQ_KEY=
GOOGLE_KEY=
MISTRAL_KEY=
OPENROUTER_KEY=
NVIDIA_KEY=
HUGGINGFACE_KEY=
# B.AI (docs.b.ai): una clave para modelos de Claude, GPT, Gemini, Qwen y más. Necesita saldo.
BAI_KEY=

# --- Opcional -----------------------------------------------------------------
# Cambiar el orden de los servicios (por ejemplo, empezar por los gratuitos):
# IA_ORDEN=groq,google,mistral,openrouter,nvidia,anthropic,huggingface
# Cambiar el modelo de un servicio: <SERVICIO>_MODELO, por ejemplo:
# ANTHROPIC_MODELO=claude-haiku-5-5
# GROQ_MODELO=openai/gpt-oss-120b

# Voz a texto (micrófono de los chats): usa GROQ_KEY con Whisper.
